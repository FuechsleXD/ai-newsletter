<?xml version="1.0" encoding="UTF-8"?>
<!--
  Process digestRun (docs/04-prozess-bpmn.md). The model describes HOW a run works; WHICH models,
  aggregator and recipients are used comes from the database (ADR-002, ADR-013). No model, provider
  or recipient names, no scripts and no business logic in this file. Editable with the Camunda
  Modeler (CIB seven uses the Camunda 7 extension namespace).
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="digestRunDefinitions"
                  targetNamespace="https://fuechsle.de/ainewsletter/process">

  <bpmn:error id="aggregationFailedError" name="Aggregation fehlgeschlagen"
              errorCode="AGGREGATION_FAILED"/>

  <bpmn:error id="noRecipientsError" name="Keine aktiven Empfänger" errorCode="NO_RECIPIENTS"/>

  <bpmn:process id="digestRun" name="News-Digest-Lauf" isExecutable="true">
    <!-- After every end of a run its costs are recorded: check the warn threshold of the budget
         (once per month, never fails the run). -->
    <bpmn:extensionElements>
      <camunda:executionListener event="end" delegateExpression="${budgetWarningListener}"/>
    </bpmn:extensionElements>

    <bpmn:startEvent id="startEvent" name="Lauf angefordert">
      <bpmn:outgoing>toPrepareRun</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Synchronous: runs in the transaction of DigestProcessStarter, so a second active run of
         the topic is rejected directly by the partial unique index. -->
    <bpmn:serviceTask id="prepareRun" name="Lauf vorbereiten"
                      camunda:delegateExpression="${prepareRunDelegate}">
      <bpmn:incoming>toPrepareRun</bpmn:incoming>
      <bpmn:outgoing>toCheckBudget</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="checkBudget" name="Budget prüfen"
                      camunda:delegateExpression="${checkBudgetDelegate}">
      <bpmn:incoming>toCheckBudget</bpmn:incoming>
      <bpmn:outgoing>toBudgetGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="budgetGateway" name="Budget ok?">
      <bpmn:incoming>toBudgetGateway</bpmn:incoming>
      <bpmn:outgoing>budgetOk</bpmn:outgoing>
      <bpmn:outgoing>budgetExhausted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Fork/join around the research make the parallelism visible and are the extension point for
         further parallel branches (ADR-004). -->
    <bpmn:parallelGateway id="researchFork" name="Recherche starten">
      <bpmn:incoming>budgetOk</bpmn:incoming>
      <bpmn:outgoing>toResearch</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- One parallel instance per research model. Async attributes on the activity apply to the
         multi-instance body, those on multiInstanceLoopCharacteristics to every inner instance:
         - inner instances: asyncBefore and non-exclusive, one job each, so they really run at the
           same time (exclusive jobs of one process instance would run one after another)
         - inner instances: asyncAfter, so the model call and its result are committed before the
           instance completes; instances completing together then only conflict in the small
           completion job (OptimisticLockingException, retried by the engine) and the model is
           never called twice
         - body: asyncAfter, so the join runs in its own transaction after all instances ended -->
    <bpmn:serviceTask id="research" name="Recherche"
                      camunda:delegateExpression="${researchDelegate}"
                      camunda:asyncAfter="true">
      <bpmn:incoming>toResearch</bpmn:incoming>
      <bpmn:outgoing>toResearchJoin</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:asyncBefore="true"
          camunda:asyncAfter="true" camunda:exclusive="false"
          camunda:collection="${digestRunVariables.modelIds(models)}"
          camunda:elementVariable="model"/>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="researchJoin" name="Alle Recherchen beendet">
      <bpmn:incoming>toResearchJoin</bpmn:incoming>
      <bpmn:outgoing>toCheckNews</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="checkNews" name="Meldungen prüfen"
                      camunda:delegateExpression="${checkNewsDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:incoming>toCheckNews</bpmn:incoming>
      <bpmn:outgoing>toOutcomeGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="outcomeGateway" name="Ergebnis der Recherche?">
      <bpmn:incoming>toOutcomeGateway</bpmn:incoming>
      <bpmn:outgoing>validNews</bpmn:outgoing>
      <bpmn:outgoing>noValidNews</bpmn:outgoing>
      <bpmn:outgoing>noneSucceeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="aggregate" name="Aggregieren"
                      camunda:delegateExpression="${aggregateDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:incoming>validNews</bpmn:incoming>
      <bpmn:outgoing>toRender</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- The aggregator model failed or its answer stayed invalid after the repair attempt: no
         retries (they would pay the same failing call again), inform the operator instead. -->
    <bpmn:boundaryEvent id="aggregationFailed" name="Aggregation fehlgeschlagen"
                        attachedToRef="aggregate">
      <bpmn:outgoing>toNotifyOperatorAggregation</bpmn:outgoing>
      <bpmn:errorEventDefinition id="aggregationFailedDefinition"
                                 errorRef="aggregationFailedError"/>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="notifyOperatorAggregation" name="Betreiber informieren"
                      camunda:delegateExpression="${notifyOperatorDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationReason">AGGREGATION_FAILED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>toNotifyOperatorAggregation</bpmn:incoming>
      <bpmn:outgoing>aggregationToFinishFailed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="render" name="HTML und PDF erzeugen"
                      camunda:delegateExpression="${renderDigestDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:incoming>toRender</bpmn:incoming>
      <bpmn:outgoing>toSendMails</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- The topic has no active recipients: nobody would get the digest. -->
    <bpmn:boundaryEvent id="noRecipients" name="Keine Empfänger" attachedToRef="render">
      <bpmn:outgoing>toNotifyOperatorNoRecipients</bpmn:outgoing>
      <bpmn:errorEventDefinition id="noRecipientsDefinition" errorRef="noRecipientsError"/>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="notifyOperatorNoRecipients" name="Betreiber informieren"
                      camunda:delegateExpression="${notifyOperatorDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationReason">NO_RECIPIENTS</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>toNotifyOperatorNoRecipients</bpmn:incoming>
      <bpmn:outgoing>noRecipientsToFinishFailed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="sendMails" name="Mails versenden"
                      camunda:delegateExpression="${sendMailsDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:incoming>toSendMails</bpmn:incoming>
      <bpmn:outgoing>toMailGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Some recipients failed for good, but at least one got the mail (otherwise: incident). -->
    <bpmn:exclusiveGateway id="mailGateway" name="Alle zugestellt?">
      <bpmn:incoming>toMailGateway</bpmn:incoming>
      <bpmn:outgoing>allSent</bpmn:outgoing>
      <bpmn:outgoing>partiallySent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="notifyOperatorMail" name="Betreiber informieren"
                      camunda:delegateExpression="${notifyOperatorDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationReason">MAIL_PARTIALLY_FAILED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>partiallySent</bpmn:incoming>
      <bpmn:outgoing>mailToFinishCompleted</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="finishCompleted" name="Lauf abschließen"
                      camunda:delegateExpression="${finishRunDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="runStatus">COMPLETED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>allSent</bpmn:incoming>
      <bpmn:incoming>mailToFinishCompleted</bpmn:incoming>
      <bpmn:outgoing>toEndCompleted</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="endCompleted" name="Digest verschickt">
      <bpmn:incoming>toEndCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="finishNoNews" name="Lauf ohne Meldungen abschließen"
                      camunda:delegateExpression="${finishRunDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="runStatus">NO_NEWS</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>noValidNews</bpmn:incoming>
      <bpmn:outgoing>toEndNoNews</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="endNoNews" name="Keine Meldungen">
      <bpmn:incoming>toEndNoNews</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="notifyOperatorFailed" name="Betreiber informieren"
                      camunda:delegateExpression="${notifyOperatorDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationReason">NO_MODEL_SUCCEEDED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>noneSucceeded</bpmn:incoming>
      <bpmn:outgoing>toFinishFailed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="finishFailed" name="Lauf als fehlgeschlagen abschließen"
                      camunda:delegateExpression="${finishRunDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="runStatus">FAILED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>toFinishFailed</bpmn:incoming>
      <bpmn:incoming>aggregationToFinishFailed</bpmn:incoming>
      <bpmn:incoming>noRecipientsToFinishFailed</bpmn:incoming>
      <bpmn:outgoing>toEndFailed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="endFailed" name="Lauf fehlgeschlagen">
      <bpmn:incoming>toEndFailed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="notifyOperatorBudget" name="Betreiber informieren"
                      camunda:delegateExpression="${notifyOperatorDelegate}"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationReason">BUDGET_EXHAUSTED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>budgetExhausted</bpmn:incoming>
      <bpmn:outgoing>toFinishSkipped</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="finishSkipped" name="Lauf als übersprungen abschließen"
                      camunda:delegateExpression="${finishRunDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="runStatus">SKIPPED_BUDGET</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>toFinishSkipped</bpmn:incoming>
      <bpmn:outgoing>toEndSkipped</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="endSkipped" name="Budget erreicht">
      <bpmn:incoming>toEndSkipped</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="toPrepareRun" sourceRef="startEvent" targetRef="prepareRun"/>
    <bpmn:sequenceFlow id="toCheckBudget" sourceRef="prepareRun" targetRef="checkBudget"/>
    <bpmn:sequenceFlow id="toBudgetGateway" sourceRef="checkBudget" targetRef="budgetGateway"/>
    <bpmn:sequenceFlow id="budgetOk" name="ja" sourceRef="budgetGateway" targetRef="researchFork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${budgetOk}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="budgetExhausted" name="nein" sourceRef="budgetGateway" targetRef="notifyOperatorBudget">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!budgetOk}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toResearch" sourceRef="researchFork" targetRef="research"/>
    <bpmn:sequenceFlow id="toResearchJoin" sourceRef="research" targetRef="researchJoin"/>
    <bpmn:sequenceFlow id="toCheckNews" sourceRef="researchJoin" targetRef="checkNews"/>
    <bpmn:sequenceFlow id="toOutcomeGateway" sourceRef="checkNews" targetRef="outcomeGateway"/>
    <bpmn:sequenceFlow id="validNews" name="gültige Meldungen" sourceRef="outcomeGateway" targetRef="aggregate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${researchOutcome == 'VALID_NEWS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="noValidNews" name="keine gültige Meldung" sourceRef="outcomeGateway" targetRef="finishNoNews">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${researchOutcome == 'NO_VALID_NEWS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="noneSucceeded" name="kein Modell erfolgreich" sourceRef="outcomeGateway" targetRef="notifyOperatorFailed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${researchOutcome == 'NONE_SUCCEEDED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toRender" sourceRef="aggregate" targetRef="render"/>
    <bpmn:sequenceFlow id="toNotifyOperatorAggregation" sourceRef="aggregationFailed" targetRef="notifyOperatorAggregation"/>
    <bpmn:sequenceFlow id="aggregationToFinishFailed" sourceRef="notifyOperatorAggregation" targetRef="finishFailed"/>
    <bpmn:sequenceFlow id="toSendMails" sourceRef="render" targetRef="sendMails"/>
    <bpmn:sequenceFlow id="toNotifyOperatorNoRecipients" sourceRef="noRecipients" targetRef="notifyOperatorNoRecipients"/>
    <bpmn:sequenceFlow id="noRecipientsToFinishFailed" sourceRef="notifyOperatorNoRecipients" targetRef="finishFailed"/>
    <bpmn:sequenceFlow id="toMailGateway" sourceRef="sendMails" targetRef="mailGateway"/>
    <bpmn:sequenceFlow id="allSent" name="ja" sourceRef="mailGateway" targetRef="finishCompleted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${mailOutcome == 'ALL_SENT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="partiallySent" name="nein" sourceRef="mailGateway" targetRef="notifyOperatorMail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${mailOutcome == 'PARTIALLY_SENT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="mailToFinishCompleted" sourceRef="notifyOperatorMail" targetRef="finishCompleted"/>
    <bpmn:sequenceFlow id="toEndCompleted" sourceRef="finishCompleted" targetRef="endCompleted"/>
    <bpmn:sequenceFlow id="toEndNoNews" sourceRef="finishNoNews" targetRef="endNoNews"/>
    <bpmn:sequenceFlow id="toFinishFailed" sourceRef="notifyOperatorFailed" targetRef="finishFailed"/>
    <bpmn:sequenceFlow id="toEndFailed" sourceRef="finishFailed" targetRef="endFailed"/>
    <bpmn:sequenceFlow id="toFinishSkipped" sourceRef="notifyOperatorBudget" targetRef="finishSkipped"/>
    <bpmn:sequenceFlow id="toEndSkipped" sourceRef="finishSkipped" targetRef="endSkipped"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="digestRunDiagram">
    <bpmndi:BPMNPlane id="digestRunPlane" bpmnElement="digestRun">
      <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
        <dc:Bounds x="152" y="202" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="128" y="245" width="84" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prepareRun_di" bpmnElement="prepareRun">
        <dc:Bounds x="230" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="checkBudget_di" bpmnElement="checkBudget">
        <dc:Bounds x="380" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="budgetGateway_di" bpmnElement="budgetGateway" isMarkerVisible="true">
        <dc:Bounds x="530" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="527" y="165" width="56" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="researchFork_di" bpmnElement="researchFork">
        <dc:Bounds x="630" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="612" y="165" width="86" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="research_di" bpmnElement="research">
        <dc:Bounds x="730" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="researchJoin_di" bpmnElement="researchJoin">
        <dc:Bounds x="880" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="855" y="158" width="100" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="checkNews_di" bpmnElement="checkNews">
        <dc:Bounds x="980" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="outcomeGateway_di" bpmnElement="outcomeGateway" isMarkerVisible="true">
        <dc:Bounds x="1130" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1105" y="158" width="100" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="aggregate_di" bpmnElement="aggregate">
        <dc:Bounds x="1230" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="aggregationFailed_di" bpmnElement="aggregationFailed">
        <dc:Bounds x="1262" y="162" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1300" y="140" width="76" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyOperatorAggregation_di" bpmnElement="notifyOperatorAggregation">
        <dc:Bounds x="1380" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="render_di" bpmnElement="render">
        <dc:Bounds x="1380" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendMails_di" bpmnElement="sendMails">
        <dc:Bounds x="1530" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mailGateway_di" bpmnElement="mailGateway" isMarkerVisible="true">
        <dc:Bounds x="1680" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1666" y="252" width="78" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyOperatorMail_di" bpmnElement="notifyOperatorMail">
        <dc:Bounds x="1780" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="noRecipients_di" bpmnElement="noRecipients">
        <dc:Bounds x="1444" y="242" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1488" y="280" width="80" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyOperatorNoRecipients_di" bpmnElement="notifyOperatorNoRecipients">
        <dc:Bounds x="1530" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finishCompleted_di" bpmnElement="finishCompleted">
        <dc:Bounds x="1780" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endCompleted_di" bpmnElement="endCompleted">
        <dc:Bounds x="1932" y="202" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1906" y="245" width="88" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finishNoNews_di" bpmnElement="finishNoNews">
        <dc:Bounds x="1230" y="310" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endNoNews_di" bpmnElement="endNoNews">
        <dc:Bounds x="1382" y="332" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1358" y="375" width="84" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyOperatorFailed_di" bpmnElement="notifyOperatorFailed">
        <dc:Bounds x="1230" y="440" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finishFailed_di" bpmnElement="finishFailed">
        <dc:Bounds x="1380" y="440" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endFailed_di" bpmnElement="endFailed">
        <dc:Bounds x="1532" y="462" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1500" y="505" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyOperatorBudget_di" bpmnElement="notifyOperatorBudget">
        <dc:Bounds x="630" y="310" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finishSkipped_di" bpmnElement="finishSkipped">
        <dc:Bounds x="780" y="310" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSkipped_di" bpmnElement="endSkipped">
        <dc:Bounds x="932" y="332" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="912" y="375" width="76" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="toPrepareRun_di" bpmnElement="toPrepareRun">
        <di:waypoint x="188" y="220"/><di:waypoint x="230" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toCheckBudget_di" bpmnElement="toCheckBudget">
        <di:waypoint x="330" y="220"/><di:waypoint x="380" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toBudgetGateway_di" bpmnElement="toBudgetGateway">
        <di:waypoint x="480" y="220"/><di:waypoint x="530" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="budgetOk_di" bpmnElement="budgetOk">
