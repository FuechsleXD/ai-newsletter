# Template for the env file of docker-compose.prod.yml. Copy to .env.prod (never checked in).
# On the server the values come from AWS Secrets Manager (roadmap step 11). Never put real secrets
# or mail addresses into this template.

# Public host name; "localhost" for a local test (Caddy then uses its internal CA)
DOMAIN=

# App image with a fixed tag (Git SHA), never latest, e.g. newsdigest:<git-sha>
APP_IMAGE=

# PostgreSQL superuser (administration only) and the users of the app
POSTGRES_DB=newsdigest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_MIGRATION_PASSWORD=
DB_APP_PASSWORD=

# AWS (ADR-015): region and PDF bucket from Terraform; the AI keys are read by the app itself
# from Secrets Manager with the instance role, they are never in this file
AWS_REGION=eu-central-1
NEWSDIGEST_STORAGE_S3BUCKET=

# Mail: SES SMTP interface (STARTTLS, port 587); credentials from Secrets Manager
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
NEWSDIGEST_MAIL_FROM=
NEWSDIGEST_MAIL_OPERATOR=
