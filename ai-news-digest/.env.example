# Copy to .env for local development. .env is git-ignored. Never put real secrets or mail addresses here.
# Spring Boot does not read .env itself: load it into the shell environment before
# `./mvnw spring-boot:run` (or set the variables in the IDE run configuration).

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=newsdigest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only

# Database users (created by docker/postgres/init/01-create-users.sh, used by the app)
DB_URL=jdbc:postgresql://localhost:5432/newsdigest
DB_MIGRATION_PASSWORD=change-me-local-only
DB_APP_PASSWORD=change-me-local-only

# Mail (local: Mailpit, no authentication)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
NEWSDIGEST_MAIL_FROM=digest@example.test
NEWSDIGEST_MAIL_OPERATOR=operator@example.test
