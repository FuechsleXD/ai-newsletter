# Copy to .env for local development. .env is git-ignored. Never put real secrets or mail addresses here.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=newsdigest
POSTGRES_USER=newsdigest
POSTGRES_PASSWORD=change-me-local-only

# Mail (local: Mailpit, no authentication)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
NEWSDIGEST_MAIL_FROM=digest@example.test
NEWSDIGEST_MAIL_OPERATOR=operator@example.test
